<Window x:Class="ReNative3D36S.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReNative3DS | R3D" Icon="/Assets/ReNative3D36S-icon.png"
        Width="1480" Height="960" MinWidth="1140" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#091421" Foreground="#EDF4FF"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#14263B"/>
        <SolidColorBrush x:Key="PanelDark" Color="#0C192B"/>
        <SolidColorBrush x:Key="SubText" Color="#A5BDD6"/>
        <SolidColorBrush x:Key="Stroke" Color="#304863"/>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#132C4A" Offset="0"/>
            <GradientStop Color="#0E2034" Offset="0.64"/>
            <GradientStop Color="#091829" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#188AF5" Offset="0"/>
            <GradientStop Color="#0960C4" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
            <Setter Property="BorderBrush" Value="#223F5A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#2A405C"/>
            <Setter Property="Foreground" Value="#EDF4FF"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderBrush" Value="#35516E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#355D86"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.44"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#268BEE"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.90"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,16"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A395A"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1C31"/>
            <Setter Property="Foreground" Value="#F0F7FF"/>
            <Setter Property="BorderBrush" Value="#355371"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Dark ComboBox: evita texto branco sobre o menu suspenso branco do tema do Windows.
             Os itens definidos explicitamente no XAML usam o estilo implícito abaixo. -->
        <Style x:Key="DarkComboItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#EDF6FF"/>
            <Setter Property="Background" Value="#10263D"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#255A86"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#1461A3"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Também alcança ComboBoxItems escritos diretamente dentro do ComboBox. -->
        <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource DarkComboItem}"/>
        <Style x:Key="DarkComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#F2F7FF"/>
            <Setter Property="Background" Value="#1D3550"/>
            <Setter Property="BorderBrush" Value="#3F6488"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MaxDropDownHeight" Value="250"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="OuterBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
                            <ToggleButton x:Name="DropDownToggle" ClickMode="Press"
                                          Focusable="False" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Grid Background="Transparent">
                                            <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#B2D7F5" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- IsHitTestVisible impede que o texto bloqueie cliques no dropdown. -->
                            <ContentPresenter x:Name="SelectionContent" IsHitTestVisible="False"
                                              Margin="13,0,39,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" RecognizesAccessKey="True"
                                              TextElement.Foreground="#F2F7FF"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom" PopupAnimation="Fade"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border x:Name="DropdownSurface" Background="#10263D"
                                        BorderBrush="#368CD1" BorderThickness="1" CornerRadius="7"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2,4" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#5CB2F6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#55B6FF"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="SelectionContent" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="166"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- Brand header: typography and badges only, NO console imagery. -->
        <Border Grid.Row="0" Margin="13,12,13,8" Background="{StaticResource HeroBrush}" CornerRadius="15" BorderThickness="1" BorderBrush="#174775">
            <Grid Margin="23,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/><ColumnDefinition Width="188"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="91" Height="91" CornerRadius="20" Background="#091B32" BorderBrush="#1688DA" BorderThickness="2" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="R3D" FontWeight="Black" FontSize="29" Foreground="#5AC7FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="NATIVE" Foreground="#A6CBEA" HorizontalAlignment="Center" FontWeight="Bold" FontSize="10"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" FontSize="39" Margin="0,0,0,0">
                        <Run Text="ReNative "/><Run Text="3DS" Foreground="#41B7FF"/>
                    </TextBlock>
                    <TextBlock x:Name="SubtitleText" Text="Recompile jogos 3DS para R36S e portáteis compatíveis" Foreground="#B6CFE8" FontSize="15" Margin="0,0,0,13"/>
                    <WrapPanel>
                        <Border Background="#173757" CornerRadius="10" Padding="10,5" Margin="0,0,7,5"><TextBlock x:Name="Feature1" Text="✓ Fácil de usar" FontSize="11"/></Border>
                        <Border Background="#173757" CornerRadius="10" Padding="10,5" Margin="0,0,7,5"><TextBlock x:Name="Feature2" Text="▣ R36S / ArkOS" FontSize="11"/></Border>
                        <Border Background="#173757" CornerRadius="10" Padding="10,5" Margin="0,0,7,5"><TextBlock x:Name="Feature3" Text="↻ Atualizações" FontSize="11"/></Border>
                        <Border Background="#173757" CornerRadius="10" Padding="10,5" Margin="0,0,7,5"><TextBlock x:Name="Feature4" Text="◎ PT / EN / ES / RU" FontSize="11"/></Border>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="R3D" Foreground="#48BAFF" FontWeight="Black" FontSize="52" HorizontalAlignment="Right"/>
                    <TextBlock Text="v0.2.0 • Motores" FontSize="12" Foreground="#BACDE5" HorizontalAlignment="Right"/>
                    <Border CornerRadius="10" Padding="11,6" Background="#134A58" HorizontalAlignment="Right" Margin="0,9,0,0"><TextBlock Text="Pocket Native" FontSize="12" Foreground="#7CF4CB"/></Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="13,5,13,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="178"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="318"/>
            </Grid.ColumnDefinitions>
            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Margin="0,0,13,0" Background="#101F33" BorderBrush="#203D59" BorderThickness="1" CornerRadius="13">
                <DockPanel Margin="9,15,9,12">
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,10,0,5">
                        <Separator Background="#2A4260" Margin="0,5,0,12"/>
                        <TextBlock Text="ReNative3DS" FontSize="12" Foreground="#BED2E9"/>
                        <TextBlock Text="v0.2.0" Foreground="#81A7C7" FontSize="11" Margin="0,3,0,12"/>
                        <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#25CD80" Margin="0,3,8,0"/><TextBlock x:Name="SidebarStatusText" Text="Pronto" Foreground="#9ED9C2"/></StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <Button x:Name="NavRecompile" Style="{StaticResource Nav}" Background="#174E7C" Click="NavRecompile_Click" Content="⌂   Recompilar"/>
                        <Button x:Name="NavUpdates" Style="{StaticResource Nav}" Click="NavUpdates_Click" Content="↻   Atualizações"/>
                        <Button x:Name="NavEngines" Style="{StaticResource Nav}" Click="NavEngines_Click" Content="⚙   Motores"/>
                        <Button x:Name="NavLibrary" Style="{StaticResource Nav}" Click="NavLibrary_Click" Content="▣   Biblioteca"/>
                        <Button x:Name="NavSettings" Style="{StaticResource Nav}" Click="NavSettings_Click" Content="⚙   Configurações"/>
                        <Button x:Name="AboutBtn" Style="{StaticResource Nav}" Click="About_Click" Content="♡   Sobre / Apoiar"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Column="1" Margin="0,0,13,0">
                <ScrollViewer x:Name="RecompilePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock x:Name="ActiveEngineTitle" Style="{StaticResource SectionTitle}" Text="Motor selecionado"/>
                            <ComboBox x:Name="EngineSelector" Style="{StaticResource DarkComboBox}" SelectionChanged="Engine_SelectionChanged" Background="#253C57" Foreground="White" MinHeight="40">
                                <ComboBoxItem Tag="pocket" Content="Pocket Native Oficial"/>
                                <ComboBoxItem Tag="renative" Content="ReNative Optimized (em desenvolvimento)"/>
                                <ComboBoxItem Tag="local" Content="Pocket Native: fork local (experimental)"/>
                                <ComboBoxItem Tag="zakuro" Content="Zakuro + 3dsrecomp (Windows)"/>
                            </ComboBox>
                            <TextBlock x:Name="ActiveEngineStatus" Margin="0,9,0,3" Foreground="#80E6C2" FontWeight="SemiBold" TextWrapping="Wrap" Text="Oficial • Disponível mediante Docker"/>
                            <TextBlock x:Name="ActiveEngineDetails" Style="{StaticResource Hint}" Text="Saída para R36S/ArkOS."/>
                            <Button x:Name="OpenEnginesBtn" Content="Gerenciar motores e dependências" Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="NavEngines_Click"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="RomTitle" Style="{StaticResource SectionTitle}" Text="1. ROM do Nintendo 3DS"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="RomPath" Grid.Column="0" Style="{StaticResource Input}" IsReadOnly="True" ToolTip="Arquivo próprio .3ds, .cci ou .cia"/>
                                    <Button x:Name="SelectRomBtn" Grid.Column="1" Style="{StaticResource Action}" Content="Escolher ROM" Margin="10,0,0,0" Click="SelectRom_Click"/>
                                </Grid>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock x:Name="RomStateText" DockPanel.Dock="Right" Text="○ Nenhum arquivo" FontSize="11" Foreground="#AAC2DA"/>
                                    <TextBlock x:Name="RomHint" Style="{StaticResource Hint}" Text="Arquivos CIA podem exigir aes_keys.txt do seu console."/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="OutTitle" Style="{StaticResource SectionTitle}" Text="2. Destino da recompilação"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutPath" Style="{StaticResource Input}" IsReadOnly="True" TextChanged="Destination_TextChanged"/>
                                    <Button x:Name="SelectOutBtn" Grid.Column="1" Style="{StaticResource Action}" Content="Escolher pasta" Click="SelectOut_Click" Margin="10,0,0,0"/>
                                </Grid>
                                <CheckBox x:Name="NameFolderCheck" Margin="0,11,0,8" IsChecked="True" Checked="Naming_Checked" Unchecked="Naming_Checked" Foreground="#DCEAF8" Content="Criar pasta com nome do jogo"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FolderNameLabel" Text="Nome personalizado:" Foreground="#ACBFDA" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FolderNameBox" Grid.Column="1" Style="{StaticResource Input}" TextChanged="FolderName_TextChanged"/>
                                </Grid>
                                <Border Background="#0C1B2D" CornerRadius="8" Padding="11,8" Margin="0,11,0,5">
                                    <StackPanel>
                                        <TextBlock x:Name="OutputPreviewTitle" Text="Prévia da estrutura de saída" Foreground="#DCEEFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="FolderPreviewRoot" Text="↳ Recomps/" FontFamily="Consolas" Foreground="#90B7DA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="FolderPreviewName" Text="   ├── Jogo/" FontFamily="Consolas" Foreground="#8DD3FF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="FolderPreviewLauncher" Text="   └── Jogo.sh" FontFamily="Consolas" Foreground="#8DD3FF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="OutHint" Style="{StaticResource Hint}" Text="Copie a pasta e seu launcher .sh para roms/ports."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="PrepTitle" Style="{StaticResource SectionTitle}" Text="3. Preparar e recompilar"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                    <Button x:Name="PrepareBtn" Style="{StaticResource Action}" Click="Prepare_Click" Content="Preparar ambiente"/>
                                    <Button x:Name="BuildBtn" Grid.Column="1" Margin="9,0,9,0" Style="{StaticResource Primary}" Click="Build_Click" Content="▶ Iniciar recompilação"/>
                                    <Button x:Name="CancelBtn" Grid.Column="2" Style="{StaticResource Action}" Click="Cancel_Click" Content="Cancelar" IsEnabled="False"/>
                                </Grid>
                                <DockPanel Margin="0,13,0,7">
                                    <TextBlock x:Name="ProgressLabel" DockPanel.Dock="Right" Text="0% • etapas" FontWeight="Bold" Foreground="#C8E6FF"/>
                                    <TextBlock x:Name="StatusLabel" Text="Pronto para começar." Foreground="#AFCCE5" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ProgressBar x:Name="WorkProgress" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="#21C37A" Background="#2B4056" BorderThickness="0"/>
                                <DockPanel Margin="0,7,0,0">
                                    <TextBlock x:Name="ElapsedTimeText" DockPanel.Dock="Right" Foreground="#9DBDD5" FontSize="11" Text="Tempo decorrido: 00:00:00"/>
                                    <TextBlock x:Name="ProgressDisclaimer" Style="{StaticResource Hint}" Text="Progresso por etapas; o tempo real depende do jogo."/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Background="#0A1422">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9"><TextBlock x:Name="ActivityTitle" Text="Registro de atividades" FontWeight="SemiBold" FontSize="14"/><Button x:Name="OpenLogsBtn" DockPanel.Dock="Right" Style="{StaticResource Action}" MinHeight="27" Padding="9,4" FontSize="11" Click="OpenLogs_Click" Content="Ver logs" HorizontalAlignment="Right"/></DockPanel>
                                <TextBox x:Name="LogBox" Background="Transparent" Foreground="#C8DDF4" FontFamily="Consolas" FontSize="11" Height="136" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="FooterLabel" Style="{StaticResource Hint}" Text="ReNative3D36S v0.2.0 · experimental · ROMs próprias" Margin="0,0,0,7"/>
                    </StackPanel>
                </ScrollViewer>
                <!-- Update and library tabs are actual functional pages, not mock buttons. -->
                <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock x:Name="UpdatesPageTitle" Text="Atualizações do Pocket Native" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="UpdatesPageInfo" Text="O motor e a base de perfis são independentes do executável Windows. Atualizações do motor podem exigir uma nova recompilação dos jogos já gerados." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                            <TextBlock x:Name="UpdatesDetails" Text="Verifique a versão disponível pelo GitHub." Foreground="#E3EDFA" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button x:Name="UpdatePageCheckBtn" Click="CheckUpdate_Click" Content="↻  Verificar versões" Style="{StaticResource Action}" Margin="0,0,7,7"/>
                                <Button x:Name="UpdatePageCoreBtn" Click="UpdateCore_Click" Content="↓  Atualizar motor" Style="{StaticResource Primary}" Margin="0,0,7,7"/>
                                <Button x:Name="UpdatePageProfilesBtn" Click="UpdateProfiles_Click" Content="▣  Atualizar perfis" Style="{StaticResource Action}" Margin="0,0,7,7"/>
                            </WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock x:Name="UpdatesNoticeTitle" Text="Atualizações sem perder jogos" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="UpdatesNoticeText" Style="{StaticResource Hint}" Text="O programa preserva a versão anterior do kit. O núcleo atualizado vale para novas recompilações; não substitui automaticamente binários ARM64 de jogos existentes."/>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="LibraryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="LibraryTitle" Text="Biblioteca de recompilações" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="LibraryHint" Style="{StaticResource Hint}" Margin="0,0,0,12" Text="Jogos encontrados na pasta de destino selecionada. Sem acesso a ROMs ou saves fora dessa pasta."/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="RefreshLibraryBtn" Content="↻  Atualizar biblioteca" Click="LibraryRefresh_Click" Style="{StaticResource Action}" Margin="0,0,8,0"/>
                                    <Button x:Name="OpenFolderBtn" Content="Abrir resultado" Click="OpenFolder_Click" Style="{StaticResource Action}"/>
                                </WrapPanel>
                                <ListBox x:Name="LibraryList" MinHeight="245" Background="#0D1B2D" Foreground="#E3F3FF" BorderBrush="#36516F" BorderThickness="1" Padding="8" FontSize="13" SelectionMode="Single" MouseDoubleClick="LibraryOpen_Click"/>
                                <Button x:Name="OpenLibrarySelectionBtn" Content="Abrir jogo selecionado" Click="LibraryOpen_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Engines are isolated: no third-party binary is bundled in the frontend. -->
                <ScrollViewer x:Name="EnginesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock x:Name="EnginesPageTitle" Style="{StaticResource SectionTitle}" Text="Motores de recompilação"/>
                            <TextBlock x:Name="EnginesPageIntro" Style="{StaticResource Hint}" Text="Cada motor possui capacidades e dependências diferentes. Os recursos não implementados não são apresentados como funcionais." Margin="0,0,0,12"/>
                            <ComboBox x:Name="EngineSelectorPage" Style="{StaticResource DarkComboBox}" SelectionChanged="EnginePage_SelectionChanged" Background="#253C57" Foreground="White" MinHeight="40">
                                <ComboBoxItem Tag="pocket" Content="Pocket Native Oficial"/>
                                <ComboBoxItem Tag="renative" Content="ReNative Optimized (em desenvolvimento)"/>
                                <ComboBoxItem Tag="local" Content="Pocket Native: fork local (experimental)"/>
                                <ComboBoxItem Tag="zakuro" Content="Zakuro + 3dsrecomp (Windows)"/>
                            </ComboBox>
                            <Border Background="#0B192B" Padding="13" Margin="0,14,0,10" CornerRadius="8"><StackPanel>
                                <TextBlock x:Name="EngineStatusPage" FontWeight="SemiBold" Foreground="#80E6C2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="EngineDetailsPage" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                                <TextBlock x:Name="EngineTargetPage" Foreground="#9BDAFF" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel></Border>
                            <TextBlock x:Name="EngineSourceTitle" Text="Projeto original e créditos" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Button x:Name="OpenEngineSourceBtn" Style="{StaticResource Action}" Content="Abrir repositório oficial ↗" HorizontalAlignment="Left" Click="OpenEngineSource_Click"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock x:Name="EngineConfigTitle" Style="{StaticResource SectionTitle}" Text="Configurar motor externo"/>
                            <TextBlock x:Name="EngineConfigIntro" Style="{StaticResource Hint}" Text="Escolha a pasta de um fork local compatível ou o recompilador recomp3ds.exe oficial instalado por você. Não baixamos nem redistribuímos esses programas." Margin="0,0,0,9"/>
                            <Button x:Name="SelectForkBtn" Click="SelectFork_Click" Style="{StaticResource Action}" Content="Selecionar pasta de fork local" HorizontalAlignment="Left" Margin="0,0,0,7"/>
                            <TextBlock x:Name="ForkPathLabel" Style="{StaticResource Hint}" Text="Fork: não configurado" Margin="0,0,0,12"/>
                            <Button x:Name="SelectRecompilerBtn" Click="SelectRecompiler_Click" Style="{StaticResource Action}" Content="Selecionar recomp3ds.exe (Windows)" HorizontalAlignment="Left" Margin="0,0,0,7"/>
                            <TextBlock x:Name="RecompilerPathLabel" Style="{StaticResource Hint}" Text="3dsrecomp: não configurado"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock x:Name="EngineResearchTitle" Style="{StaticResource SectionTitle}" Text="Outros projetos: pesquisa, sem integração de recompilação"/>
                            <TextBlock x:Name="EngineResearchText" Style="{StaticResource Hint}" Text="ScarletNX 3DS: experimental, sem gameplay confirmado; licenciado sob GPLv3. Azahar: emulador 3DS (não recompilação estática). Nenhum dos dois é incluído ou executado por este software." Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Content="ScarletNX ↗" Style="{StaticResource Action}" Margin="0,0,7,0" Click="OpenScarlet_Click"/>
                                <Button Content="Azahar ↗" Style="{StaticResource Action}" Click="OpenAzahar_Click"/>
                            </WrapPanel>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock x:Name="SettingsTitle" Text="Configurações" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="SettingsInfo" Style="{StaticResource Hint}" Text="O idioma é detectado automaticamente. Uma escolha manual será lembrada." Margin="0,0,0,13"/>
                            <TextBlock x:Name="SettingsLanguageTitle" Text="Idioma da interface" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox x:Name="LanguageSelectorSettings" Style="{StaticResource DarkComboBox}" SelectionChanged="LanguageSettings_SelectionChanged" Width="230" HorizontalAlignment="Left" Background="#273E5B" Foreground="White" Height="40">
                                <ComboBoxItem Tag="auto" Content="Auto / Sistema"/><ComboBoxItem Tag="pt" Content="Português (Brasil)"/><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="es" Content="Español"/><ComboBoxItem Tag="ru" Content="Русский"/>
                            </ComboBox>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock x:Name="SettingsHelpTitle" Text="Docker e R36S" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="SettingsHelpText" Style="{StaticResource Hint}" Text="Abra Docker Desktop, aguarde até que esteja funcionando e autorize o acesso às pastas quando solicitado. Consulte também as instruções originais do Pocket Native em caso de falha." Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button x:Name="OfficialDocsBtn" Click="OpenOriginal_Click" Style="{StaticResource Action}" Content="Documentação oficial ↗" Margin="0,0,8,8"/>
                                <Button x:Name="DockerDocsBtn" Click="OpenDockerDocs_Click" Style="{StaticResource Action}" Content="Documentação do Docker ↗" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- RIGHT SIDEBAR -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="EngineCardTitle" Text="⚙ Motor Pocket Native" Style="{StaticResource SectionTitle}"/>
                            <Separator Background="#2C4965" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock x:Name="InstalledCaption" Text="Versão instalada" Style="{StaticResource Hint}"/><TextBlock x:Name="VersionInstalledLabel" Text="não instalado" FontSize="23" FontWeight="Bold" Foreground="#50D995" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="AvailableCaption" Text="Versão disponível" Style="{StaticResource Hint}"/><TextBlock x:Name="VersionAvailableLabel" Text="verificando..." FontSize="23" FontWeight="Bold" Foreground="#50D995" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                            <Button x:Name="CheckUpdateBtn" Click="CheckUpdate_Click" Style="{StaticResource Primary}" Content="↻ Verificar atualizações" Margin="0,0,0,8"/>
                            <Button x:Name="UpdateCoreBtn" Click="UpdateCore_Click" Style="{StaticResource Action}" Content="Atualizar motor" Margin="0,0,0,8"/>
                            <Button x:Name="UpdateProfilesBtn" Click="UpdateProfiles_Click" Style="{StaticResource Action}" Content="Atualizar base de perfis"/>
                            <TextBlock x:Name="VersionLabel" Text="Pocket Native: não verificado" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                            <TextBlock x:Name="LastCheckLabel" Text="Última verificação: ainda não" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="LanguageCardTitle" Text="◎ Idioma / Language" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="LanguageSelector" Style="{StaticResource DarkComboBox}" SelectionChanged="Language_SelectionChanged" Background="#273E5B" Foreground="White" Height="39">
                                <ComboBoxItem Tag="auto" Content="Auto / Sistema"/><ComboBoxItem Tag="pt" Content="Português (Brasil)"/><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="es" Content="Español"/><ComboBoxItem Tag="ru" Content="Русский"/>
                            </ComboBox>
                            <TextBlock x:Name="LanguageCaption" Style="{StaticResource Hint}" Margin="0,9,0,0" Text="Idioma detectado do Windows; alterável manualmente."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="QuickTitle" Text="Atalhos rápidos" Style="{StaticResource SectionTitle}"/>
                            <Button x:Name="QuickOutputBtn" Click="OpenFolder_Click" Style="{StaticResource Action}" Content="▣  Abrir pasta de saída" Margin="0,0,0,7" HorizontalContentAlignment="Left"/>
                            <Button x:Name="QuickKitBtn" Click="OpenKit_Click" Style="{StaticResource Action}" Content="▣  Abrir pasta do Pocket Native" Margin="0,0,0,7" HorizontalContentAlignment="Left"/>
                            <Button x:Name="QuickLogBtn" Click="OpenLogs_Click" Style="{StaticResource Action}" Content="▤  Ver registro de atividades" Margin="0,0,0,7" HorizontalContentAlignment="Left"/>
                            <Button x:Name="QuickCleanBtn" Click="CleanCache_Click" Style="{StaticResource Action}" Content="⚒  Limpar cache de compilação" HorizontalContentAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
