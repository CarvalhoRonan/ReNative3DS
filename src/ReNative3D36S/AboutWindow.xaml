<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ReNative3D36S.AboutWindow" Title="Sobre • ReNative3D36S" Width="730" Height="785" MinWidth="650" MinHeight="580" WindowStartupLocation="CenterOwner" Background="#101827" Foreground="#E7EDF7">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#25415D"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <DockPanel Margin="24">
    <Button x:Name="CloseBtn" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="95" Content="Fechar" Click="Close_Click" Margin="0,12,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock FontSize="29" FontWeight="Bold">
          <Run Text="ReNative"/>
          <Run Foreground="#55C9FF" Text="3D36S"/>
        </TextBlock>
        <TextBlock Text="v0.2.0 • Native game recompiler para R36S" Foreground="#9FB3CB" Margin="0,2,0,15"/>
        <Border Background="#182438" CornerRadius="12" Padding="16">
          <StackPanel>
            <TextBlock x:Name="OnlineTitle" FontSize="16" FontWeight="SemiBold" Text="Overclock Informática na internet" Margin="0,0,0,10"/>
            <UniformGrid Columns="2">
              <StackPanel HorizontalAlignment="Center">
                <Border Background="White" Padding="6" CornerRadius="6">
                  <Image Source="/Assets/instagram.png" Width="103" Height="103"/>
                </Border>
                <Button x:Name="InstagramBtn" Click="Instagram_Click" Content="Instagram ↗"/>
              </StackPanel>
              <StackPanel HorizontalAlignment="Center">
                <Border Background="White" Padding="6" CornerRadius="6">
                  <Image Source="/Assets/links.png" Width="103" Height="103"/>
                </Border>
                <Button x:Name="LinksBtn" Click="Links_Click" Content="Página de links ↗"/>
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Background="#182438" CornerRadius="12" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="SupportTitle" FontSize="16" FontWeight="SemiBold" Text="Apoie o desenvolvimento ♡" Margin="0,0,0,7"/>
            <TextBlock x:Name="SupportDescription" TextWrapping="Wrap" Foreground="#ADBFDA" Text="As doações são opcionais e ajudam a manter atualizações e melhorias. Nenhuma funcionalidade é bloqueada para quem não contribuir." Margin="0,0,0,12"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" BorderBrush="#38516E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock x:Name="PixLabel" Text="Pix • Brasil" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,9"/>
                  <Border Background="White" Padding="8" CornerRadius="7" HorizontalAlignment="Center">
                    <Image Source="/Assets/pix.png" Height="158" Width="158" Stretch="Uniform"/>
                  </Border>
                  <TextBlock Text="QR Pix estático • valor livre" FontSize="11" Foreground="#ACC0D8" HorizontalAlignment="Center" Margin="0,9,0,8"/>
                  <Button x:Name="CopyPixBtn" Click="CopyPix_Click" Content="Copiar código Pix" HorizontalAlignment="Stretch"/>
                  <Button x:Name="CopyKeyBtn" Click="CopyPixKey_Click" Content="Copiar chave aleatória" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" BorderBrush="#38516E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="7,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock x:Name="KofiLabel" Text="Ko-fi • Internacional" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,9"/>
                  <Border Background="White" Padding="8" CornerRadius="7" HorizontalAlignment="Center">
                    <Image Source="/Assets/kofi.png" Height="158" Width="158" Stretch="Uniform"/>
                  </Border>
                  <TextBlock Text="ko-fi.com/overclockinformatica" FontSize="10" Foreground="#ACC0D8" HorizontalAlignment="Center" Margin="0,9,0,8"/>
                  <Button x:Name="OpenKofiBtn" Click="Kofi_Click" Content="Abrir página Ko-fi ↗" HorizontalAlignment="Stretch"/>
                  <Button x:Name="CopyKofiBtn" Click="CopyKofi_Click" Content="Copiar link do Ko-fi" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="Confirme sempre os dados do beneficiário exibidos no aplicativo do seu banco antes de doar." Foreground="#C8DBEE" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#182438" CornerRadius="12" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="AboutProjectTitle" FontSize="16" FontWeight="SemiBold" Text="Sobre o projeto" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#D3E0F0" Text="Interface independente para preparar o ambiente de compilação e recompilar ROMs próprias de Nintendo 3DS usando o núcleo Pocket Native, com saída destinada a R36S e outros portáteis compatíveis."/>
            <TextBlock Margin="0,9,0,0" Foreground="#A9C6E6" Text="Desenvolvimento da interface: Overclock Informática"/>
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#93AAC7" Text="Motor de recompilação: whovian64/pocket-native (MIT), derivado de Zakuro e 3dsrecomp. Créditos e licenças de terceiros são preservados no resultado compilado."/>
            <Button x:Name="OriginalBtn" Click="PocketNative_Click" HorizontalAlignment="Left" Content="Ver projeto original no GitHub ↗" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#182438" CornerRadius="12" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="EngineCreditsTitle" Text="Créditos aos desenvolvedores dos motores" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <TextBlock x:Name="CreditsPocketText" TextWrapping="Wrap" Foreground="#D2E1F3" Text="Pocket Native — desenvolvido e mantido por whovian64 (whovian), com código original de fearkov e contribuições do projeto WINDROID-EMU/3dsrecomp. Licença MIT, direitos © 2026 fearkov e © 2026 whovian."/>
            <Button Click="PocketNative_Click" HorizontalAlignment="Left" Content="Pocket Native: GitHub ↗" Margin="0,7,0,11"/>
            <TextBlock x:Name="CreditsZakuroText" TextWrapping="Wrap" Foreground="#D2E1F3" Text="Zakuro e 3dsrecomp — projetos originais de fearkov. Zakuro usa licença MIT; 3dsrecomp descreve sua integração na documentação oficial. O usuário instala essas ferramentas separadamente."/>
            <WrapPanel Margin="0,7,0,10">
              <Button Click="Zakuro_Click" Content="Zakuro: GitHub ↗" Margin="0,0,7,0"/>
              <Button Click="Recompiler_Click" Content="3dsrecomp: GitHub ↗"/>
            </WrapPanel>
            <TextBlock x:Name="CreditsOtherText" TextWrapping="Wrap" Foreground="#D2E1F3" Text="ScarletNX — projeto da equipe scarletnx, GPLv3, backend 3DS experimental sem gameplay confirmado. Azahar — projeto da comunidade azahar-emu, GPLv3, emulador e não recompilador estático. Ambos são apenas referências; seus binários/códigos não são incluídos."/>
            <WrapPanel Margin="0,7,0,10">
              <Button Click="Scarlet_Click" Content="ScarletNX ↗" Margin="0,0,7,0"/>
              <Button Click="Azahar_Click" Content="Azahar ↗"/>
            </WrapPanel>
            <TextBlock x:Name="CreditsDisclaimerText" TextWrapping="Wrap" Foreground="#9CB4D2" FontSize="11" Text="As marcas pertencem aos seus titulares. Este aplicativo é independente e não possui vínculo nem endosso desses projetos ou da Nintendo. Avisos completos em THIRD_PARTY_NOTICES.md."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
